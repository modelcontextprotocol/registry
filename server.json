{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json", 
  "name": "io.github.vindataio/vindata-mcp",
  "description": "An MCP server for accessing Vindata tools and services.",
  "repository": {
    "url": "https://github.com/vindataio/registry",
    "source": "github"
  },
  "version": "1.0.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@vindataio/registry",
      "version": "1.0.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "Your API key for the service",
          "isRequired": true,
          "format": "string",
          "isSecret": true,
          "name": "YOUR_API_KEY"
        }
      ]
    }
  ]
}