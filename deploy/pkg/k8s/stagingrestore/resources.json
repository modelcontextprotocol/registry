                "containers": [
                  {
                    "name": "start",
                    "image": "python:3.12-slim-bookworm",
                    "command": [
                      "python3",
                      "/scripts/run.py",
                      "start"
                    ],
                    "env": [
                      {
                        "name": "RESTORE_ENVIRONMENT",
                        "value": "staging"
