                      {
                        "name": "work",
                        "mountPath": "/work"
                      }
                    ],
                    "securityContext": {
                      "allowPrivilegeEscalation": false,
                      "capabilities": {
                        "drop": [
                          "ALL"
                        ]
                      }
                    },
                    "resources": {
                      "requests": {
                        "cpu": "100m",
                        "memory": "128Mi",
                        "ephemeral-storage": "1Gi"
                      },
                      "limits": {
                        "cpu": "500m",
                        "memory": "512Mi",
                        "ephemeral-storage": "3Gi"
                      }
                    }
                  }
