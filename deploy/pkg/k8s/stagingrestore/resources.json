                  {
                    "name": "restore",
                    "image": "postgres:17",
                    "command": [
                      "/bin/sh",
                      "-ec"
                    ],
                    "args": [
                      "set -eu\numask 077\ntrap 'rc=$?; if [ $rc -ne 0 ]; then echo REGISTRY_STAGING_RESTORE_FAILED phase=restore >&2; fi' EXIT\ncd /work/backup\nsha256sum -c registry.dump.sha256\npg_restore --exit-on-error --single-transaction --clean --if-exists --no-owner --no-privileges --use-list=/work/restore-toc --dbname=app registry.dump\npsql -X -v ON_ERROR_STOP=1 -c 'ANALYZE;'\ntest \"$(psql -X -At -v ON_ERROR_STOP=1 -c 'SELECT count(*) FROM public.servers')\" -gt 0\ntest \"$(psql -X -At -v ON_ERROR_STOP=1 -c 'SELECT count(*) FROM public.schema_migrations')\" -gt 0\necho REGISTRY_STAGING_RESTORE_DATABASE_VALIDATED"
                    ],
                    "env": [
                      {
                        "name": "PGHOST",
                        "value": "registry-pg-rw"
                      },
                      {
                        "name": "PGPORT",
                        "value": "5432"
                      },
                      {
                        "name": "PGDATABASE",
                        "value": "app"
                      },
                      {
                        "name": "PGSSLMODE",
                        "value": "require"
                      },
                      {
                        "name": "PGCONNECT_TIMEOUT",
                        "value": "20"
                      },
                      {
                        "name": "PGOPTIONS",
                        "value": "-c lock_timeout=30s -c statement_timeout=1200000"
                      },
                      {
                        "name": "PGUSER",
                        "valueFrom": {
                          "secretKeyRef": {
                            "name": "registry-pg-app",
                            "key": "username"
                          }
                        }
                      },
                      {
                        "name": "PGPASSWORD",
                        "valueFrom": {
                          "secretKeyRef": {
                            "name": "registry-pg-app",
                            "key": "password"
                          }
                        }
                      }
