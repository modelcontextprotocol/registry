    {
      "apiVersion": "batch/v1",
      "kind": "CronJob",
      "metadata": {
        "name": "registry-staging-restore",
        "namespace": "default",
        "labels": {
          "environment": "staging"
        }
      },
      "spec": {
        "schedule": "0 6 * * 0",
        "timeZone": "UTC",
        "suspend": "__SUSPEND__",
        "concurrencyPolicy": "Forbid",
        "startingDeadlineSeconds": 3600,
        "successfulJobsHistoryLimit": 2,
        "failedJobsHistoryLimit": 3,
        "jobTemplate": {
          "metadata": {
            "labels": {
              "app": "registry-staging-restore"
            }
          },
          "spec": {
            "backoffLimit": 0,
            "activeDeadlineSeconds": 2100,
            "template": {
              "metadata": {
                "labels": {
                  "app": "registry-staging-restore",
                  "environment": "staging"
                }
              },
              "spec": {
                "serviceAccountName": "registry-staging-restore",
                "automountServiceAccountToken": false,
                "restartPolicy": "Never",
                "securityContext": {
                  "runAsNonRoot": true,
                  "runAsUser": 65532,
                  "runAsGroup": 65532,
                  "fsGroup": 65532
                },
                "nodeSelector": {
                  "registry-role": "worker"
