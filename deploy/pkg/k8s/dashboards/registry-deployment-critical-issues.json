            "type": "victoriametrics-logs-datasource",
            "uid": "PD775F2863313E6C7"
          },
          "editorMode": "code",
          "expr": "k8s.event.reason:(OOMKilling OR SystemOOM OR OOMKilled)\n  | format \"<k8s.object.kind>/<k8s.object.name>: <_msg>\" as _msg\n  | fields _time, _msg, k8s.event.reason, k8s.namespace.name, k8s.object.kind, k8s.object.name, k8s.node.name, k8s.event.count\n  | sort by (_time) desc",
          "queryType": "instant",
          "refId": "A"
        }
      ],
