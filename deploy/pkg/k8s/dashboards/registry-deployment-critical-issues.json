    {
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "PD775F2863313E6C7"
      },
      "description": "Kubernetes events of type Warning about the registry's own objects (pods, jobs, autoscaler), counted in 10-minute steps. Events about nodes are left out; the node panel below covers the ones that matter. Events are collected for the default namespace only.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 0,
            "stacking": {
              "group": "A",
              "mode": "normal"
            }
          },
          "decimals": 0,
          "min": 0,
          "noValue": "No warnings",
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "id": 13,
      "options": {
        "legend": {
          "calcs": [
            "sum"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "sortBy": "Total",
          "sortDesc": true
        },
        "tooltip": {
          "hideZeros": true,
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "PD775F2863313E6C7"
          },
          "editorMode": "code",
          "expr": "severity:Warning k8s.namespace.name:* | stats by (k8s.event.reason) count() as events",
          "legendFormat": "{{k8s.event.reason}}",
          "queryType": "statsRange",
          "refId": "A",
          "step": "10m"
        }
      ],
      "title": "Warning events per 10 minutes, by reason",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "PD775F2863313E6C7"
      },
      "description": "A pod could not be placed on any node. A few while the cluster adds a node for a new pod are normal; a pod that stays here is stuck.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 9,
      "options": {
        "dedupStrategy": "exact",
        "enableInfiniteScrolling": false,
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "PD775F2863313E6C7"
          },
          "editorMode": "code",
          "expr": "k8s.event.reason:FailedScheduling\n  | format \"<k8s.object.kind>/<k8s.object.name>: <_msg>\" as _msg\n  | fields _time, _msg, k8s.event.reason, k8s.namespace.name, k8s.object.kind, k8s.object.name, k8s.node.name, k8s.event.count\n  | sort by (_time) desc",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Failed scheduling",
      "type": "logs"
    },
    {
      "datasource": {
        "type": "victoriametrics-logs-datasource",
