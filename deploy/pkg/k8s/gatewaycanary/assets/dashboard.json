{
  "uid": "registry-gateway-canary",
  "title": "Registry Gateway Canary",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "gateway-canary"
  ],
  "timezone": "utc",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "15s",
  "links": [
    {
      "type": "link",
      "icon": "dashboard",
      "title": "Application board",
      "tooltip": "Availability, errors, requests and response time of the registry application",
      "url": "/d/1d4f7dbe-3a6c-47c7-adf3-da688b509748",
      "targetBlank": false,
      "keepTime": true,
      "includeVars": false,
      "asDropdown": false,
      "tags": []
    },
    {
      "type": "link",
      "icon": "dashboard",
      "title": "Deployment board",
      "tooltip": "Kubernetes warning events, and the registry pods' memory and CPU",
      "url": "/d/83a0f65c-bac4-40ce-a197-e77d67431ef4",
      "targetBlank": false,
      "keepTime": true,
      "includeVars": false,
      "asDropdown": false,
      "tags": []
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Requests / second",
      "type": "timeseries",
      "description": "Requests the gateway receives, by route. This includes listings it answers from its cache, which never reach the registry application.",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "reqps"
        },
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "P4169E866C3094E38"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(registry_gateway_canary_requests_total{traffic=\"$traffic\"}[5m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "p95 client latency",
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "s"
        },
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "P4169E866C3094E38"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by (le,route)(rate(registry_gateway_canary_request_duration_seconds_bucket{traffic=\"$traffic\"}[5m])))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Cache hit fraction",
      "type": "timeseries",
      "description": "Share of all responses the gateway marked as a cache hit. Stale answers, which it also serves from the cache while it refreshes an entry, are not counted as hits.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "P4169E866C3094E38"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(registry_gateway_canary_cache_responses_total{traffic=\"$traffic\",cache=\"HIT\"}[5m])) / sum(rate(registry_gateway_canary_cache_responses_total{traffic=\"$traffic\"}[5m]))",
          "legendFormat": "Cache hits"
        }
      ]
    },
    {
      "id": 4,
      "title": "HTTP 5xx / second",
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "axisSoftMax": 1
          },
          "min": 0,
          "unit": "reqps"
        },
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "P4169E866C3094E38"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(registry_gateway_canary_requests_total{traffic=\"$traffic\",status=~\"5..\"}[5m])) or vector(0)",
          "legendFormat": "5xx responses"
        }
      ]
    },
    {
      "id": 5,
      "title": "p95 response bytes including headers",
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "bytes"
        },
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "P4169E866C3094E38"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by (le)(rate(registry_gateway_canary_response_bytes_bucket{traffic=\"$traffic\"}[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 6,
      "title": "Internal cache refreshes / second",
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "reqps"
        },
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "P4169E866C3094E38"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(registry_gateway_canary_internal_requests_total{traffic=\"$traffic\"}[5m]))",
          "legendFormat": "Cache refreshes"
        }
      ]
    },
    {
      "id": 7,
      "title": "Upstream p95 latency (single attempt)",
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "s"
        },
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "P4169E866C3094E38"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by (le)(rate(registry_gateway_canary_upstream_duration_seconds_bucket{traffic=\"$traffic\"}[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 8,
      "title": "Parse / CRI / timing errors per second",
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "axisSoftMax": 1
          },
          "min": 0,
          "unit": "ops"
        },
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "P4169E866C3094E38"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(registry_gateway_canary_parse_errors_total[5m])) or vector(0)",
          "legendFormat": "parse_errors"
        },
        {
          "refId": "B",
          "expr": "sum(rate(registry_gateway_canary_cri_errors_total[5m])) or vector(0)",
          "legendFormat": "cri_errors"
        },
        {
          "refId": "C",
          "expr": "sum(rate(registry_gateway_canary_upstream_timing_errors_total[5m])) or vector(0)",
          "legendFormat": "upstream_timing_errors"
        },
        {
          "refId": "D",
          "expr": "sum(rate(registry_gateway_canary_response_bytes_missing_total[5m])) or vector(0)",
          "legendFormat": "response_bytes_missing"
        }
      ]
    },
    {
      "id": 9,
      "title": "Scrape health",
      "type": "timeseries",
      "description": "1 while a gateway metrics target answers its scrape, 0 when it does not.",
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "max": 1,
          "min": 0
        },
        "overrides": []
      },
      "datasource": {
        "type": "prometheus",
        "uid": "P4169E866C3094E38"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"gateway-canary-.*\"}",
          "legendFormat": "{{job}} {{instance}}"
        }
      ]
    },
    {
      "id": 10,
      "title": "p95 upstream time summed across measured attempts",
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {
          "min": 0,
