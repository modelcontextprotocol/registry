{
  "uid": "registry-gateway-canary",
  "title": "Registry Gateway Canary",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "gateway-canary"
  ],
  "timezone": "utc",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "title": "Requests / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "P4169E866C3094E38"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(registry_gateway_canary_requests_total{traffic=\"$traffic\"}[5m]))",
          "legendFormat": "{{route}} {{job}} {{instance}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "p95 client latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "P4169E866C3094E38"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by (le,route)(rate(registry_gateway_canary_request_duration_seconds_bucket{traffic=\"$traffic\"}[5m])))",
          "legendFormat": "{{route}} {{job}} {{instance}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Cache hit fraction",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "P4169E866C3094E38"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(registry_gateway_canary_cache_responses_total{traffic=\"$traffic\",cache=\"HIT\"}[5m])) / sum(rate(registry_gateway_canary_cache_responses_total{traffic=\"$traffic\"}[5m]))",
          "legendFormat": "{{route}} {{job}} {{instance}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "HTTP 5xx / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "P4169E866C3094E38"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(registry_gateway_canary_requests_total{traffic=\"$traffic\",status=~\"5..\"}[5m]))",
          "legendFormat": "{{route}} {{job}} {{instance}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "p95 response bytes including headers",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "P4169E866C3094E38"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by (le)(rate(registry_gateway_canary_response_bytes_bucket{traffic=\"$traffic\"}[5m])))",
          "legendFormat": "{{route}} {{job}} {{instance}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Internal cache refreshes / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "P4169E866C3094E38"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(registry_gateway_canary_internal_requests_total{traffic=\"$traffic\"}[5m]))",
          "legendFormat": "{{route}} {{job}} {{instance}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Upstream p95 latency (single attempt)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "P4169E866C3094E38"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by (le)(rate(registry_gateway_canary_upstream_duration_seconds_bucket{traffic=\"$traffic\"}[5m])))",
          "legendFormat": "{{route}} {{job}} {{instance}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Parse / CRI / timing errors per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "P4169E866C3094E38"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(registry_gateway_canary_parse_errors_total[5m])) or vector(0)",
          "legendFormat": "parse_errors"
        },
        {
          "refId": "B",
          "expr": "sum(rate(registry_gateway_canary_cri_errors_total[5m])) or vector(0)",
          "legendFormat": "cri_errors"
        },
        {
          "refId": "C",
          "expr": "sum(rate(registry_gateway_canary_upstream_timing_errors_total[5m])) or vector(0)",
          "legendFormat": "upstream_timing_errors"
        },
        {
          "refId": "D",
          "expr": "sum(rate(registry_gateway_canary_response_bytes_missing_total[5m])) or vector(0)",
          "legendFormat": "response_bytes_missing"
        }
      ]
    },
    {
      "id": 9,
      "title": "Scrape health",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "P4169E866C3094E38"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"gateway-canary-.*\"}",
          "legendFormat": "{{route}} {{job}} {{instance}}"
        }
      ]
    },
    {
      "id": 10,
      "title": "p95 upstream time summed across measured attempts",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "P4169E866C3094E38"
      },
