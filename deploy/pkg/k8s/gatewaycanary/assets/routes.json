  {
    "apiVersion": "gateway.networking.k8s.io/v1",
    "kind": "Gateway",
    "metadata": {
      "name": "registry-canary",
      "namespace": "registry-gateway-canary",
      "annotations": {
        "pulumi.com/skipAwait": "true"
      }
    },
    "spec": {
      "gatewayClassName": "registry-gateway-canary",
      "listeners": [
        {
          "name": "http",
          "port": 80,
          "protocol": "HTTP",
          "allowedRoutes": {
            "namespaces": {
              "from": "Same"
            }
          }
        },
        {
          "name": "registry",
          "hostname": "staging.registry.modelcontextprotocol.io",
          "port": 443,
          "protocol": "HTTPS",
          "tls": {
            "mode": "Terminate",
            "certificateRefs": [
              {
                "name": "mcp-registry-staging-tls",
                "namespace": "default"
              }
            ]
          },
          "allowedRoutes": {
            "namespaces": {
              "from": "Same"
            }
          }
        },
        {
          "name": "grafana",
          "hostname": "grafana.staging.registry.modelcontextprotocol.io",
          "port": 443,
          "protocol": "HTTPS",
          "tls": {
            "mode": "Terminate",
            "certificateRefs": [
              {
                "name": "grafana-tls",
                "namespace": "monitoring"
              }
            ]
          },
          "allowedRoutes": {
            "namespaces": {
              "from": "Same"
            }
          }
        },
        {
          "name": "fixture",
          "port": 443,
          "protocol": "HTTPS",
          "tls": {
            "mode": "Terminate",
            "certificateRefs": [
              {
                "name": "fixture-tls"
              }
            ]
          },
          "allowedRoutes": {
            "namespaces": {
              "from": "Same"
            }
          }
        }
      ]
    }
  },
  {
    "apiVersion": "gateway.networking.k8s.io/v1",
    "kind": "HTTPRoute",
    "metadata": {
      "name": "redirect",
      "namespace": "registry-gateway-canary"
    },
    "spec": {
      "parentRefs": [
        {
          "name": "registry-canary",
          "sectionName": "http"
        }
      ],
      "hostnames": [
        "staging.registry.modelcontextprotocol.io",
        "grafana.staging.registry.modelcontextprotocol.io"
      ],
      "rules": [
        {
          "filters": [
            {
              "type": "RequestRedirect",
              "requestRedirect": {
                "scheme": "https",
                "statusCode": 308
              }
            },
            {
              "type": "ExtensionRef",
              "extensionRef": {
                "group": "gateway.nginx.org",
                "kind": "SnippetsFilter",
                "name": "canonical-redirect"
              }
            }
          ]
        }
      ]
    }
  },
