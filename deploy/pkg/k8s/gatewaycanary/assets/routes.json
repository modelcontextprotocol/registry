  {
    "apiVersion": "gateway.nginx.org/v1alpha1",
    "kind": "SnippetsPolicy",
    "metadata": {
      "name": "shared",
      "namespace": "registry-gateway-canary"
    },
    "spec": {
      "targetRefs": [
        {
          "group": "gateway.networking.k8s.io",
          "kind": "Gateway",
          "name": "registry-canary"
        }
      ],
      "snippets": [
        {
          "context": "http",
          "value": "proxy_cache_path /var/cache/nginx/registry-read levels=1:2 keys_zone=registry_read_cache:20m max_size=1g inactive=5m use_temp_path=off;\nmap \"$request_method:$uri\" $registry_read_cache_zone { default off; ~^GET:/v0(?:\\.1)?/servers$ registry_read_cache; }\nlog_subrequest on;\nmap $http_x_request_id $registry_request_id { default $http_x_request_id; \"\" $request_id; }\n\n# Public listing responses contain no user-specific data. Leave credentials/cookies uncompressed.\nmap \"$request_method:$host:$uri:$http_authorization:$http_cookie\" $registry_public_json_gzip {\n    default 0;\n    ~^(GET|HEAD):(registry\\.modelcontextprotocol\\.io|prod\\.registry\\.modelcontextprotocol\\.io|staging\\.registry\\.modelcontextprotocol\\.io|fixture\\.gateway-canary\\.invalid|alias\\.gateway-canary\\.invalid):/v0(?:\\.1)?/servers::$ 1;\n}\n\n# Store only successful origin responses, even if errors advertise freshness.\nmap $upstream_status $registry_skip_cache_status { default 1; 200 0; \"~[, :]+200$\" 0; }\n\n# Preserve the live production TLS/session and client header contract.\nssl_protocols TLSv1.2 TLSv1.3;\nssl_session_cache shared:SSL:10m;\nssl_session_timeout 10m;\nssl_session_tickets off;\nssl_buffer_size 4k;\nssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;\nssl_prefer_server_ciphers on;\nclient_header_buffer_size 1k;\nlarge_client_header_buffers 4 8k;\nclient_header_timeout 60s;\nclient_body_buffer_size 8k;\n\n# Match ingress-nginx HTTP redirect canonicalization without changing HTTPS paths.\nmap $request_uri $registry_redirect_uri {\n    default \"\";\n    ~^(.*)/$ https://$host$1;\n}\n"
        },
        {
          "context": "http.server",
          "value": "add_header Strict-Transport-Security \"max-age=31536000; includeSubDomains\" always;"
        },
        {
          "context": "http.server.location",
          "value": "proxy_set_header X-Forwarded-For $remote_addr;\nproxy_set_header X-Request-ID $registry_request_id;\nadd_header Strict-Transport-Security \"max-age=31536000; includeSubDomains\" always;\n# Preserve production retry bounds and upstream header handling.\nproxy_next_upstream error timeout;\nproxy_next_upstream_timeout 0;\nproxy_next_upstream_tries 3;\nproxy_http_version 1.1;\nproxy_request_buffering on;\nproxy_redirect off;\nproxy_set_header Proxy \"\";\nproxy_set_header X-Forwarded-Scheme $scheme;\nproxy_set_header X-Scheme $scheme;\nproxy_set_header X-Original-Forwarded-For $http_x_forwarded_for;\nproxy_set_header X-Original-Forwarded-Host $http_x_forwarded_host;\n"
        }
      ]
    }
  },
  {
    "apiVersion": "gateway.nginx.org/v1alpha1",
    "kind": "SnippetsFilter",
    "metadata": {
      "name": "public-read",
      "namespace": "registry-gateway-canary"
    },
    "spec": {
      "snippets": [
        {
          "context": "http.server.location",
          "value": "proxy_cache $registry_read_cache_zone;\nproxy_cache_key \"$scheme$request_method$host$request_uri\";\nproxy_cache_valid 200 30s;\nproxy_no_cache $registry_skip_cache_status;\nproxy_cache_lock on;\nproxy_cache_lock_timeout 5s;\nproxy_cache_background_update on;\nproxy_cache_use_stale updating error timeout http_500 http_502 http_503 http_504;\nadd_header X-Registry-Cache $upstream_cache_status always;\n\n# Compress the public JSON representation after cache lookup; preserve identity fallback.\ngzip off;\ngzip_types application/json;\ngzip_min_length 1024;\ngzip_comp_level 1;\ngzip_proxied any;\ngzip_vary off;\nadd_header Vary \"Accept-Encoding\" always;\nif ($registry_public_json_gzip) {\n    gzip on;\n}\n"
        }
      ]
    }
  },
  {
    "apiVersion": "gateway.nginx.org/v1alpha1",
    "kind": "RateLimitPolicy",
    "metadata": {
      "name": "bulk",
      "namespace": "registry-gateway-canary"
    },
    "spec": {
      "targetRefs": [
