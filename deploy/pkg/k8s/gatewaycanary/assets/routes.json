          "group": "gateway.networking.k8s.io",
          "kind": "HTTPRoute",
          "name": "bulk"
        }
      ],
      "rateLimit": {
        "rejectCode": 429,
        "local": {
          "rules": [
            {
              "key": "$binary_remote_addr",
              "rate": "600r/m",
              "burst": 1800,
              "noDelay": true,
              "zoneSize": "5m"
            }
          ]
        }
      }
    }
  },
